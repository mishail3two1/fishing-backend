# Скопируй в .env и заполни. Файл .env в git не попадает.
# Значения пиши без кавычек: .env читают и docker compose, и Spring (профиль dev).

# База данных (docker-compose.yml создаёт базу fishing с этим логином и паролем)
DB_URL=jdbc:postgresql://localhost:5432/fishing
DB_USER=fishing
DB_PASSWORD=

# JWT: секрет минимум 32 символа, например вывод `openssl rand -base64 48`
JWT_SECRET=
JWT_TTL_HOURS=168

# Каталог для фото уловов
STORAGE_PATH=./storage

# Адрес фронтенда, которому разрешены запросы (CORS)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# На сервере дополнительно: SPRING_PROFILES_ACTIVE=prod
